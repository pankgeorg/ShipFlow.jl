FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}

dimensions      [0 0 -1 0 0 0 0];

// ω = √k/(Cμ^0.25·l), l = 0.07·D
internalField   uniform 4.2;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            fixedValue;
        value           $internalField;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    sides
    {
        type            slip;
    }
    propeller
    {
        type            omegaWallFunction;
        value           $internalField;
    }
}
