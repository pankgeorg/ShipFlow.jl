FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 2);   // U∞ = 2 m/s along +z (shaft axis)

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"   // procBoundary* etc.

    inlet
    {
        type            fixedValue;
        value           $internalField;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           $internalField;
    }
    sides
    {
        type            slip;
    }
    propeller
    {
        // plain no-slip: MRF adds the rotating-frame wall velocity for
        // patches inside the cellZone (not listed in nonRotatingPatches)
        type            noSlip;
    }
}
