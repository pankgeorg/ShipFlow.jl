FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];

// I = 2%: k = 1.5·(I·U)² with U = 2 m/s
internalField   uniform 2.4e-3;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            fixedValue;
        value           $internalField;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    sides
    {
        type            slip;
    }
    propeller
    {
        type            kLowReWallFunction;
        value           $internalField;
    }
}
