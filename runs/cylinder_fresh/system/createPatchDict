// Rename oldInternalFaces (created by subsetMesh) to "cylinder" with
// a wall type. Drop any leftover empty oldInternalFaces patches.

pointSync false;

patches
(
    {
        name cylinder;
        patchInfo
        {
            type wall;
        }
        constructFrom patches;
        patches (oldInternalFaces);
    }
);

