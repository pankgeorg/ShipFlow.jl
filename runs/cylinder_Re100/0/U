FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Re=20: D=0.001, U=0.3, nu=1.5e-5  ->  Re = U*D/nu = 20  (steady wake)
Uinlet          0.3;

dimensions      [0 1 -1 0 0 0 0];

// Re=20 has a steady symmetric wake — no IC perturbation needed.
internalField   uniform (0.3 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform ($Uinlet 0 0);
    }

    outlet
    {
        type            zeroGradient;
    }

    cylinder
    {
        type            noSlip;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}

