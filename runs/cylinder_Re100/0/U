FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Cylinder validation: D=0.001, U=1.5, nu=1.5e-5  ->  Re = U*D/nu = 100
Uinlet          1.5;

dimensions      [0 1 -1 0 0 0 0];

// Small y-bias breaks the perfect symmetry of the mirrored mesh and
// triggers vortex shedding in O(20 D/U) instead of O(>200 D/U).
internalField   uniform (1.5 0.15 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform ($Uinlet 0 0);
    }

    outlet
    {
        type            zeroGradient;
    }

    cylinder
    {
        type            noSlip;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}

