FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Re=20 cylinder — WaterLily-vs-OpenFOAM Cd validation (steady wake).
// D = 0.001 m, U = 0.3 m/s, nu = 1.5e-5 m^2/s  ->  Re = U*D/nu = 20
// Expected steady Cd ~ 2.04 (Tritton 1959; Sucker & Brauer 1975).
// No vortex shedding below Re~47, so this is a steady-state comparison.

solver          incompressibleFluid;

startFrom       startTime;
startTime       0;
stopAt          endTime;
// At Re=20 transients die in ~30 D/U = 0.1 s.
endTime         0.2;

deltaT          5e-5;
adjustTimeStep  yes;
maxCo           0.5;
maxDeltaT       2e-4;

writeControl    runTime;
writeInterval   0.005;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;

timeFormat      general;
timePrecision   8;

runTimeModifiable true;

functions
{
    forceCoeffs1
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        writeControl    timeStep;
        writeInterval   1;

        patches         (cylinder);
        rho             rhoInf;
        rhoInf          1.0;
        liftDir         (0 1 0);
        dragDir         (1 0 0);
        CofR            (0 0 0);
        pitchAxis       (0 0 1);
        magUInf         0.3;
        lRef            0.001;
        Aref            1e-6;
        log             true;
    }
}

