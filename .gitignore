.vscode/
.DS_Store
Manifest.toml
LocalPreferences.toml
/docs/build/

# OpenFOAM run artefacts — generated on demand by the harness.
# Keep the initial-condition `0/` directory + dictionary trees;
# exclude generated time outputs and runtime artefacts.
runs/*/log.*
runs/*/log.exitcode
runs/*/dynamicCode
runs/*/processor*
runs/*/postProcessing
runs/*/[0-9]*.[0-9]*
runs/*/[0-9]e-[0-9]*
runs/*/[0-9]*[eE][-+][0-9]*
runs/*/[1-9][0-9]*
runs/*/[1-9]
runs/cylinder_waterlily
runs/damBreak/core.*

# Per-script run dirs from the long-loop session deliverables.
# Each script seeds its own subdirectory; binary outputs and frames
# are regenerable from the scripts.
runs/bladed_rotor
runs/rudder
runs/swirling_disk
runs/vlm_full
runs/wigley_kelvin/frames
runs/wigley_kelvin/*.gif
runs/wigley_kelvin/*.png
runs/wigley_sideview
runs/wigley_yz_swirl
